# /etc/cron.d/kaspi-reminders: one-time "is merchant X still charging?" checks, run as the bot user
# (never as root: the bot can edit these scripts).
# Fields: <run-year> <label> <imported_payee substring> <only charges after YYYY-MM-DD>
HOME=/home/kaspi
0 9 17 11 * kaspi /home/kaspi/kaspi/reminders/check-merchant.sh 2026 "Streaming cancellation" "Netflix" 2026-11-16
