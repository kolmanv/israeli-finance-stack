# /etc/cron.d/finance-bot: start the Telegram bot session (tmux "finance") after boot, as the bot user.
# start-bot.sh does nothing if it is already running, and sets its own PATH.
SHELL=/bin/bash
HOME=/home/finbot
@reboot finbot sleep 60 && /home/finbot/finance/bot/start-bot.sh >> /var/log/finance-bot.log 2>&1
