# /etc/cron.d/kaspi-bot: start the Telegram bot session (tmux "kaspi") after boot, as the bot user.
# start-bot.sh does nothing if it is already running, and sets its own PATH.
SHELL=/bin/bash
HOME=/home/kaspi
@reboot kaspi sleep 60 && /home/kaspi/kaspi/bot/start-bot.sh >> /var/log/kaspi-bot.log 2>&1
